    },
    {
      "parameters": {
        "jsCode": "// Called by n8n whenever a workflow that uses this error workflow throws.\nconst { execution = {}, workflow = {} } = $input.first().json;\nconst message = execution.error?.message ?? 'No error message';\n\nreturn [{\n  json: {\n    text: [\n      '🚨 Workflow failed',\n      `Workflow: ${workflow.name ?? 'unknown'}`,\n      `Last node: ${execution.lastNodeExecuted ?? 'unknown'}`,\n      `Error: ${message.slice(0, 500)}`,\n      `Mode: ${execution.mode ?? 'unknown'}`,\n      execution.url ? `Open: ${execution.url}` : `Execution: ${execution.id ?? 'unknown'}`,\n    ].join('\\n'),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "be28e755-d0f7-4d47-b23e-07be51118bf9",
      "name": "🧾 Code - Format Alert"
    },
